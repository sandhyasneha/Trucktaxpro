@model Trucktaxpro.Models.FilingCategoryViewModel
@{
    Layout = null;
    var chromeModel = new Trucktaxpro.Models.WizardChromeViewModel
    {
        Steps = new List<string> { "Business", "Tax Period", "Vehicles", "IRS Payment", "Review", "Finish" },
        CurrentStep = 3,
        ActiveBusinessName = ViewBag.BusinessName
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Filing Category — TruckTaxPro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@@400;500;600;700&family=IBM+Plex+Sans:wght@@400;500;600&family=IBM+Plex+Mono:wght@@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
            body {
                background: var(--cream);
            }

            .app-bar {
                background: var(--ink);
                color: var(--cream);
                padding: 18px 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

                .app-bar .logo {
                    font-family: 'Oswald',sans-serif;
                    font-weight: 700;
                    font-size: 20px;
                }

                    .app-bar .logo span {
                        color: var(--amber);
                    }

                .app-bar a.exit {
                    color: #C7D2DB;
                    font-size: 13px;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

                .app-bar .user-block {
                    display: flex;
                    align-items: center;
                    gap: 18px;
                }

                    .app-bar .user-block .welcome {
                        color: var(--cream);
                        font-size: 13px;
                        font-weight: 600;
                    }

                    .app-bar .user-block button.signout {
                        background: none;
                        border: none;
                        padding: 0;
                        color: #C7D2DB;
                        font-size: 12px;
                        font-weight: 600;
                        text-transform: uppercase;
                        letter-spacing: 0.04em;
                        cursor: pointer;
                    }

            .step-tracker {
                background: var(--white);
                border-bottom: 1px solid var(--line);
                padding: 20px 40px;
                display: flex;
                gap: 0;
                overflow-x: auto;
            }

            .step-pill {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 18px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: 600;
                color: var(--steel);
                white-space: nowrap;
            }

                .step-pill .num {
                    width: 22px;
                    height: 22px;
                    border-radius: 50%;
                    background: var(--line);
                    color: var(--steel);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11px;
                    font-family: 'IBM Plex Mono',monospace;
                    flex-shrink: 0;
                }

                .step-pill.active {
                    background: rgba(242,169,59,0.12);
                    color: var(--ink);
                }

                    .step-pill.active .num {
                        background: var(--ink);
                        color: var(--amber);
                    }

            .step-arrow {
                color: var(--line);
                padding: 0 4px;
                align-self: center;
            }

            .form-wrap {
                max-width: 760px;
                margin: 0 auto;
                padding: 28px 24px 40px;
            }

            .form-card {
                background: var(--white);
                border-radius: 8px;
                border: 1px solid var(--line);
                padding: 28px 32px;
            }

                .form-card h1 {
                    font-size: 22px;
                    font-weight: 600;
                    color: var(--ink);
                    text-transform: none;
                    letter-spacing: 0;
                    margin-bottom: 4px;
                }

                .form-card .sub {
                    color: var(--steel);
                    font-size: 14px;
                    margin-bottom: 18px;
                }

            .field-error {
                color: #B23A2E;
                font-size: 12px;
                margin-top: 5px;
                display: block;
            }

            .validation-summary {
                color: #B23A2E;
                font-size: 13.5px;
                margin-bottom: 14px;
                background: #FBEAE7;
                border: 1px solid #E8B7AF;
                border-radius: 5px;
                padding: 10px 14px;
            }

                .validation-summary ul {
                    margin: 0;
                    padding-left: 18px;
                }

            .category-list {
                border: 1px solid var(--line);
                border-radius: 6px;
                overflow: hidden;
                margin-bottom: 6px;
            }

            .category-option {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 12px 16px;
                border-bottom: 1px solid var(--line);
            }

                .category-option:last-child {
                    border-bottom: none;
                }

                .category-option input[type="checkbox"] {
                    width: 17px;
                    height: 17px;
                    accent-color: var(--amber);
                    cursor: pointer;
                    margin-top: 2px;
                    flex-shrink: 0;
                }

                .category-option label {
                    cursor: pointer;
                }

                .category-option .cat-title {
                    font-size: 14.5px;
                    font-weight: 600;
                    color: var(--ink);
                    display: block;
                    margin-bottom: 2px;
                }

                .category-option .cat-desc {
                    font-size: 13px;
                    color: var(--steel);
                    line-height: 1.4;
                }

            .submit-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 20px;
            }

            .submit-btn {
                padding: 12px 30px;
                background: var(--ink);
                color: var(--cream);
                border: none;
                border-radius: 4px;
                font-weight: 600;
                font-size: 13.5px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                cursor: pointer;
            }

                .submit-btn:hover {
                    background: #1A3A56;
                }

            .prev-link {
                padding: 12px 26px;
                background: var(--ink);
                color: var(--cream);
                border: none;
                border-radius: 4px;
                font-weight: 600;
                font-size: 13.5px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                text-decoration: none;
                display: inline-block;
            }

                .prev-link:hover {
                    background: #1A3A56;
                }
    </style>
</head>
<body>

    <partial name="_WizardChrome" model="chromeModel" />

    <div class="form-wrap">
        <div class="form-card">
            <h1>Filing Category</h1>
            <p class="sub">Choose the categories of vehicles you want to e-file this return for. You can select more than one.</p>

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <form asp-action="FilingCategory" asp-controller="Filing" method="post" novalidate>
                <input type="hidden" asp-for="BusinessTaxPeriodId" />

                <div class="category-list">
                    <div class="category-option">
                        <input asp-for="IncludeTaxable" type="checkbox" id="cat-taxable" />
                        <label for="cat-taxable">
                            <span class="cat-title">Taxable Vehicles</span>
                            <span class="cat-desc">Highway motor vehicles with a taxable gross weight of 55,000 pounds or more that travel more than 5,000 miles a year (7,500 miles for agricultural vehicles) are taxable.</span>
                        </label>
                    </div>
                    <div class="category-option">
                        <input asp-for="IncludeSuspended" type="checkbox" id="cat-suspended" />
                        <label for="cat-suspended">
                            <span class="cat-title">Suspended Vehicles (Tax Exempt)</span>
                            <span class="cat-desc">A highway motor vehicle that doesn't exceed 5,000 miles a year (7,500 miles for agricultural vehicles) is exempt from tax.</span>
                        </label>
                    </div>
                    <div class="category-option">
                        <input asp-for="IncludeCredit" type="checkbox" id="cat-credit" />
                        <label for="cat-credit">
                            <span class="cat-title">Credit Vehicles</span>
                            <span class="cat-desc">Claim a credit for tax paid on vehicles that were destroyed, stolen, or sold.</span>
                        </label>
                    </div>
                    <div class="category-option">
                        <input asp-for="IncludePriorYearSoldSuspended" type="checkbox" id="cat-prioryear" />
                        <label for="cat-prioryear">
                            <span class="cat-title">Prior Year Sold Suspended Vehicles</span>
                            <span class="cat-desc">If you sold a vehicle while it was under suspension, you'll need to provide a few additional details to the IRS.</span>
                        </label>
                    </div>
                </div>

                <div class="submit-row">
                    <a href="/Filing/TaxPeriod?businessId=@ViewBag.BusinessId" class="prev-link">&larr; Previous Step</a>
                    <button type="submit" class="submit-btn">Next Step &rarr;</button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
