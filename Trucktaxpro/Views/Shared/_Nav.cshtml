@using Microsoft.AspNetCore.Identity
@using TruckTaxPro.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject TruckTaxProDbContext Db

<nav class="nav">
    <a href="/" style="display:flex;align-items:center;">
        <img src="~/images/logo.svg" alt="TruckTaxPro" style="height:44px;" />
    </a>

    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = currentUser?.FullName;

        if (string.IsNullOrWhiteSpace(displayName))
        {
            var business = Db.Businesses.FirstOrDefault(b => b.UserId == currentUser!.Id);
            displayName = business?.BusinessName;
        }
        else
        {
            displayName = displayName.Split(' ')[0];
        }

        if (string.IsNullOrWhiteSpace(displayName))
        {
            displayName = "there";
        }

        <ul>
            <li><a href="/Filing/SelectBusiness">Business Info</a></li>
            <li><a href="/Filing/SelectBusiness">2290 Filing</a></li>
            <li><a href="/Amendment">Amendment</a></li>
            <li><a href="/VinCorrection">Vin Correction</a></li>
        </ul>

        <div style="display:flex;align-items:center;gap:20px;">
            <div class="irs-badge" style="padding:6px 12px;">
                <div class="mark" style="width:28px;height:28px;font-size:11px;">IRS</div>
                <div class="txt"><b>Authorized</b>e-file provider</div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <span style="color:var(--cream);font-size:14px;font-weight:600;">Welcome, @displayName</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                    <button type="submit" style="background:none;border:none;padding:0;color:#C7D2DB;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;cursor:pointer;">Sign Out</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/#features">Features</a></li>
            <li><a href="/2290Filing">2290 Filing</a></li>
            <li><a href="/Amendment">Amendment</a></li>
            <li><a href="/VinCorrection">Vin Correction</a></li>
            <li><a href="/Faq">FAQ</a></li>
        </ul>

        <div style="display:flex;align-items:center;gap:20px;">
            <div class="irs-badge" style="padding:6px 12px;">
                <div class="mark" style="width:28px;height:28px;font-size:11px;">IRS</div>
                <div class="txt"><b>Authorized</b>e-file provider</div>
            </div>
            <a href="/Auth/Login" style="color:var(--cream);font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">Sign In</a>
            <a href="/Auth/Register" style="color:var(--cream);font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">Register</a>
            <a class="cta" href="/Auth/Register">File now</a>
        </div>
    }
</nav>