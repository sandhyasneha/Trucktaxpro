@model Trucktaxpro.Models.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Forgot Password — TruckTaxPro</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@@600;700&family=IBM+Plex+Sans:wght@@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
            .auth-wrap {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--ink);
                padding: 24px;
            }

            .auth-card {
                background: var(--white);
                border-radius: 8px;
                padding: 40px;
                width: 100%;
                max-width: 400px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            }

                .auth-card .logo {
                    font-family: 'Oswald',sans-serif;
                    font-weight: 700;
                    font-size: 22px;
                    margin-bottom: 8px;
                    color: var(--ink);
                }

                    .auth-card .logo span {
                        color: var(--amber);
                    }

                .auth-card h1 {
                    font-size: 20px;
                    text-transform: none;
                    letter-spacing: 0;
                    font-weight: 600;
                    color: var(--ink);
                    margin-bottom: 12px;
                }

                .auth-card p.desc {
                    font-size: 14px;
                    color: var(--steel);
                    margin-bottom: 24px;
                    line-height: 1.5;
                }

            .form-group {
                margin-bottom: 16px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--ink);
                    margin-bottom: 6px;
                }

                .form-group input[type=email] {
                    width: 100%;
                    padding: 11px 12px;
                    border: 1px solid var(--line);
                    border-radius: 4px;
                    font-size: 14px;
                }

            .submit-btn {
                width: 100%;
                padding: 13px;
                background: var(--ink);
                color: var(--cream);
                border: none;
                border-radius: 4px;
                font-weight: 600;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                cursor: pointer;
            }

            .validation-summary {
                color: #B23A2E;
                font-size: 13px;
                margin-bottom: 16px;
            }

            .switch-link {
                display: block;
                text-align: center;
                margin-top: 16px;
                font-size: 13px;
                color: var(--steel);
            }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="logo">TRUCK<span>TAX</span>PRO</div>
            <h1>Forgot your password?</h1>
            <p class="desc">Enter your email and we'll send you a link to reset it.</p>
            <div asp-validation-summary="All" class="validation-summary"></div>
            <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="you@example.com" />
                </div>
                <button type="submit" class="submit-btn">Send Reset Link</button>
            </form>
            <a href="/Auth/Login" class="switch-link">Back to sign in</a>
        </div>
    </div>
</body>
</html>