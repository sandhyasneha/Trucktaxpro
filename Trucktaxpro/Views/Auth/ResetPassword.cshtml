@model Trucktaxpro.Models.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reset Password — TruckTaxPro</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@@600;700&family=IBM+Plex+Sans:wght@@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
            .auth-wrap {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--ink);
                padding: 24px;
            }

            .auth-card {
                background: var(--white);
                border-radius: 8px;
                padding: 40px;
                width: 100%;
                max-width: 400px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            }

                .auth-card .logo {
                    font-family: 'Oswald',sans-serif;
                    font-weight: 700;
                    font-size: 22px;
                    margin-bottom: 8px;
                    color: var(--ink);
                }

                    .auth-card .logo span {
                        color: var(--amber);
                    }

                .auth-card h1 {
                    font-size: 20px;
                    text-transform: none;
                    letter-spacing: 0;
                    font-weight: 600;
                    color: var(--ink);
                    margin-bottom: 24px;
                }

            .form-group {
                margin-bottom: 16px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--ink);
                    margin-bottom: 6px;
                }

                .form-group input[type=password] {
                    width: 100%;
                    padding: 11px 12px;
                    border: 1px solid var(--line);
                    border-radius: 4px;
                    font-size: 14px;
                }

            .submit-btn {
                width: 100%;
                padding: 13px;
                background: var(--ink);
                color: var(--cream);
                border: none;
                border-radius: 4px;
                font-weight: 600;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                cursor: pointer;
            }

            .validation-summary {
                color: #B23A2E;
                font-size: 13px;
                margin-bottom: 16px;
            }

            .field-validation-error {
                color: #B23A2E;
                font-size: 12px;
                display: block;
                margin-top: 4px;
            }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="logo">TRUCK<span>TAX</span>PRO</div>
            <h1>Choose a new password</h1>
            <div asp-validation-summary="All" class="validation-summary"></div>
            <form asp-action="ResetPassword" asp-controller="Auth" method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div class="form-group">
                    <label asp-for="NewPassword">New password</label>
                    <input asp-for="NewPassword" type="password" placeholder="At least 8 characters" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm new password</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Re-enter password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
                <button type="submit" class="submit-btn">Reset Password</button>
            </form>
        </div>
    </div>
</body>
</html>