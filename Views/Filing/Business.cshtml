@model Trucktaxpro.Models.BusinessViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Business Info — TruckTaxPro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@@400;500;600;700&family=IBM+Plex+Sans:wght@@400;500;600&family=IBM+Plex+Mono:wght@@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
            body {
                background: var(--cream);
            }

            .app-bar {
                background: var(--ink);
                color: var(--cream);
                padding: 18px 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

                .app-bar .logo {
                    font-family: 'Oswald',sans-serif;
                    font-weight: 700;
                    font-size: 20px;
                }

                    .app-bar .logo span {
                        color: var(--amber);
                    }

                .app-bar a.exit {
                    color: #C7D2DB;
                    font-size: 13px;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

            .step-tracker {
                background: var(--white);
                border-bottom: 1px solid var(--line);
                padding: 20px 40px;
                display: flex;
                gap: 0;
                overflow-x: auto;
            }

            .step-pill {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 18px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: 600;
                color: var(--steel);
                white-space: nowrap;
            }

                .step-pill .num {
                    width: 22px;
                    height: 22px;
                    border-radius: 50%;
                    background: var(--line);
                    color: var(--steel);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11px;
                    font-family: 'IBM Plex Mono',monospace;
                    flex-shrink: 0;
                }

                .step-pill.active {
                    background: rgba(242,169,59,0.12);
                    color: var(--ink);
                }

                    .step-pill.active .num {
                        background: var(--ink);
                        color: var(--amber);
                    }

            .step-arrow {
                color: var(--line);
                padding: 0 4px;
                align-self: center;
            }

            .form-wrap {
                max-width: 760px;
                margin: 0 auto;
                padding: 48px 24px 80px;
            }

            .form-card {
                background: var(--white);
                border-radius: 8px;
                border: 1px solid var(--line);
                padding: 40px;
            }

                .form-card h1 {
                    font-size: 24px;
                    font-weight: 600;
                    color: var(--ink);
                    text-transform: none;
                    letter-spacing: 0;
                    margin-bottom: 6px;
                }

                .form-card .sub {
                    color: var(--steel);
                    font-size: 14.5px;
                    margin-bottom: 32px;
                }

            .alert-success {
                background: rgba(43,110,79,0.1);
                border: 1px solid var(--green);
                color: var(--green);
                padding: 14px 18px;
                border-radius: 6px;
                font-size: 14px;
                font-weight: 600;
                margin-bottom: 28px;
            }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--ink);
                    margin-bottom: 7px;
                    text-transform: uppercase;
                    letter-spacing: 0.03em;
                }

                .form-group .req {
                    color: #B23A2E;
                }

            .help-icon {
                width: 15px;
                height: 15px;
                border-radius: 50%;
                background: var(--line);
                color: var(--steel);
                font-size: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: help;
                font-weight: 700;
                text-transform: none;
                letter-spacing: 0;
                position: relative;
            }

                .help-icon .tip {
                    display: none;
                    position: absolute;
                    bottom: 22px;
                    left: 50%;
                    transform: translateX(-50%);
                    background: var(--ink);
                    color: var(--cream);
                    font-size: 11.5px;
                    font-weight: 400;
                    padding: 8px 12px;
                    border-radius: 5px;
                    width: 220px;
                    line-height: 1.4;
                    z-index: 5;
                }

                .help-icon:hover .tip {
                    display: block;
                }

            .form-group input, .form-group select {
                width: 100%;
                padding: 11px 12px;
                border: 1px solid var(--line);
                border-radius: 4px;
                font-size: 14px;
                font-family: 'IBM Plex Sans',sans-serif;
                color: var(--ink);
                background: var(--white);
            }

                .form-group input:focus, .form-group select:focus {
                    outline: 2px solid var(--amber);
                    outline-offset: 1px;
                    border-color: var(--amber);
                }

            .field-error {
                color: #B23A2E;
                font-size: 12px;
                margin-top: 5px;
                display: block;
            }

            .form-group input.input-error {
                border-color: #B23A2E;
            }

            .submit-row {
                display: flex;
                justify-content: flex-end;
                margin-top: 12px;
            }

            .submit-btn {
                padding: 14px 34px;
                background: var(--ink);
                color: var(--cream);
                border: none;
                border-radius: 4px;
                font-weight: 600;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                cursor: pointer;
            }

                .submit-btn:hover {
                    background: #1A3A56;
                }
    </style>
</head>
<body>

    <div class="app-bar">
        <div class="logo">TRUCK<span>TAX</span>PRO</div>
        <a href="/" class="exit">Exit to Home</a>
    </div>

    <div class="step-tracker">
        <div class="step-pill active"><span class="num">1</span> Business &amp; Tax Year Profile</div>
        <span class="step-arrow">›</span>
        <div class="step-pill"><span class="num">2</span> Filing Category</div>
        <span class="step-arrow">›</span>
        <div class="step-pill"><span class="num">3</span> Vehicles</div>
        <span class="step-arrow">›</span>
        <div class="step-pill"><span class="num">4</span> Tax Summary</div>
        <span class="step-arrow">›</span>
        <div class="step-pill"><span class="num">5</span> Review &amp; Submit</div>
    </div>

    <div class="form-wrap">
        <div class="form-card">
            <h1>Business Information</h1>
            <p class="sub">Confirm your EIN, business type, and address. This is used on every filing.</p>

            @if (TempData["BusinessSaved"] != null)
            {
                <div class="alert-success">Business information saved successfully.</div>
            }

            <div asp-validation-summary="ModelOnly" class="field-error" style="margin-bottom:20px;"></div>

            <form asp-action="Business" asp-controller="Filing" method="post" novalidate>
                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="BusinessName">Business Name <span class="req">*</span></label>
                    <input asp-for="BusinessName" type="text" placeholder="e.g. John Doe Trucking LLC" />
                    <span asp-validation-for="BusinessName" class="field-error"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Ein">
                            EIN <span class="req">*</span>
                            <span class="help-icon">?<span class="tip">Employer Identification Number — 9 digits, format XX-XXXXXXX. Cannot be a Social Security Number.</span></span>
                        </label>
                        <input asp-for="Ein" type="text" placeholder="12-3456789" maxlength="10" id="einInput" oninput="formatEin(this)" />
                        <span asp-validation-for="Ein" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="BusinessType">Business Type <span class="req">*</span></label>
                        <select asp-for="BusinessType">
                            <option value="">Select business type</option>
                            <option value="Sole Proprietorship">Sole Proprietorship</option>
                            <option value="Partnership">Partnership</option>
                            <option value="LLC">LLC</option>
                            <option value="Corporation">Corporation</option>
                            <option value="S-Corporation">S-Corporation</option>
                            <option value="Non-Profit">Non-Profit</option>
                            <option value="Government Entity">Government Entity</option>
                        </select>
                        <span asp-validation-for="BusinessType" class="field-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="AddressLine1">Address <span class="req">*</span></label>
                    <input asp-for="AddressLine1" type="text" placeholder="Street address" />
                    <span asp-validation-for="AddressLine1" class="field-error"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="City">City <span class="req">*</span></label>
                        <input asp-for="City" type="text" placeholder="City" />
                        <span asp-validation-for="City" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="State">State <span class="req">*</span></label>
                        <select asp-for="State">
                            <option value="">Select state</option>
                            <option>AL</option>
                            <option>AK</option>
                            <option>AZ</option>
                            <option>AR</option>
                            <option>CA</option>
                            <option>CO</option>
                            <option>CT</option>
                            <option>DE</option>
                            <option>FL</option>
                            <option>GA</option>
                            <option>HI</option>
                            <option>ID</option>
                            <option>IL</option>
                            <option>IN</option>
                            <option>IA</option>
                            <option>KS</option>
                            <option>KY</option>
                            <option>LA</option>
                            <option>ME</option>
                            <option>MD</option>
                            <option>MA</option>
                            <option>MI</option>
                            <option>MN</option>
                            <option>MS</option>
                            <option>MO</option>
                            <option>MT</option>
                            <option>NE</option>
                            <option>NV</option>
                            <option>NH</option>
                            <option>NJ</option>
                            <option>NM</option>
                            <option>NY</option>
                            <option>NC</option>
                            <option>ND</option>
                            <option>OH</option>
                            <option>OK</option>
                            <option>OR</option>
                            <option>PA</option>
                            <option>RI</option>
                            <option>SC</option>
                            <option>SD</option>
                            <option>TN</option>
                            <option>TX</option>
                            <option>UT</option>
                            <option>VT</option>
                            <option>VA</option>
                            <option>WA</option>
                            <option>WV</option>
                            <option>WI</option>
                            <option>WY</option>
                            <option>DC</option>
                        </select>
                        <span asp-validation-for="State" class="field-error"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ZipCode">ZIP Code <span class="req">*</span></label>
                        <input asp-for="ZipCode" type="text" placeholder="12345" maxlength="10" />
                        <span asp-validation-for="ZipCode" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PhoneNumber">Phone Number <span class="req">*</span></label>
                        <input asp-for="PhoneNumber" type="tel" placeholder="(555) 000-1234" maxlength="14" oninput="formatPhoneNumber(this)" />
                        <span asp-validation-for="PhoneNumber" class="field-error"></span>
                    </div>
                </div>

                <div class="submit-row">
                    <button type="submit" class="submit-btn">Save &amp; Continue →</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            function formatPhoneNumber(input) {
                let digits = input.value.replace(/\D/g, '').slice(0, 10);
                let formatted = '';
                if (digits.length > 0) formatted = '(' + digits.slice(0, 3);
                if (digits.length >= 3) formatted += ') ';
                if (digits.length >= 3) formatted += digits.slice(3, 6);
                if (digits.length >= 6) formatted += '-' + digits.slice(6, 10);
                input.value = formatted;
            }

            function formatEin(input) {
                let digits = input.value.replace(/\D/g, '').slice(0, 9);
                let formatted = digits;
                if (digits.length > 2) {
                    formatted = digits.slice(0, 2) + '-' + digits.slice(2);
                }
                input.value = formatted;
            }
    </script>

</body>
</html>
