@model TruckTaxPro.Domain.BlogPost
@{
    Layout = null;
    ViewData["Title"] = "Edit Blog Post";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@(Model.Id > 0 ? "Edit" : "New") Blog Post — TruckTaxPro Admin</title>
    <style>
            body {
                font-family: 'Segoe UI', sans-serif;
                background: #f4f1ea;
                margin: 0;
            }

            .top-bar {
                background: #1f3a5f;
                color: #fff;
                padding: 16px 32px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .top-bar a {
                    color: #f2a93b;
                    text-decoration: none;
                    font-weight: 600;
                    font-size: 13px;
                    margin-left: 18px;
                }

            .content {
                max-width: 780px;
                margin: 40px auto;
                background: #fff;
                padding: 32px;
                border-radius: 8px;
                border: 1px solid #ddd;
            }

            .error-msg {
                background: rgba(178,58,46,0.1);
                border: 1px solid #b23a2e;
                color: #b23a2e;
                padding: 12px 16px;
                border-radius: 6px;
                margin-bottom: 20px;
                font-size: 14px;
            }

            .form-group {
                margin-bottom: 18px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    font-weight: 600;
                    margin-bottom: 6px;
                    color: #333;
                }

                .form-group input[type=text], .form-group textarea {
                    width: 100%;
                    padding: 10px;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    font-family: inherit;
                    font-size: 14px;
                    box-sizing: border-box;
                }

                    .form-group textarea.content-area {
                        min-height: 320px;
                        font-family: 'IBM Plex Mono', monospace;
                        font-size: 13px;
                    }

                    .form-group textarea.summary-area {
                        min-height: 70px;
                    }

            .checkbox-row {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 20px;
            }

            .btn-save {
                background: #1f3a5f;
                color: #fff;
                padding: 12px 26px;
                border: none;
                border-radius: 4px;
                font-weight: 600;
                cursor: pointer;
                font-size: 14px;
            }

            .hint {
                font-size: 12.5px;
                color: #888;
                margin-top: 4px;
            }

            .back-link {
                display: inline-block;
                margin-bottom: 16px;
                font-size: 13px;
                color: #1565c0;
                text-decoration: none;
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div>TruckTaxPro Admin</div>
        <div>
            <a asp-action="Dashboard" asp-controller="Admin">Announcements</a>
            <a asp-action="BlogList" asp-controller="Admin">Blog</a>
            <a asp-action="Logout" asp-controller="Admin">Log Out</a>
        </div>
    </div>

    <div class="content">
        <a href="/Admin/BlogList" class="back-link">&larr; Back to all posts</a>
        <h2>@(Model.Id > 0 ? "Edit Post" : "New Post")</h2>

        @if (TempData["Error"] != null)
        {
            <div class="error-msg">@TempData["Error"]</div>
        }

        <form asp-action="BlogEdit" asp-controller="Admin" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PublishedAt" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="form-group">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" type="text" placeholder="e.g. Form 2290 Deadline Guide for 2026" />
            </div>

            <div class="form-group">
                <label asp-for="Slug">URL Slug (optional — auto-generated from title if left blank)</label>
                <input asp-for="Slug" type="text" placeholder="form-2290-deadline-guide-2026" />
                <div class="hint">Will appear at blog.trucktaxpro.com/your-slug-here</div>
            </div>

            <div class="form-group">
                <label asp-for="Summary">Summary (shown on the blog listing page)</label>
                <textarea asp-for="Summary" class="summary-area" placeholder="A short 1-2 sentence teaser..."></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Content">Full Post Content (HTML allowed — paste your article here)</label>
                <textarea asp-for="Content" class="content-area" placeholder="<p>Your full blog post content...</p>"></textarea>
            </div>

            <div class="checkbox-row">
                <input asp-for="IsPublished" type="checkbox" id="pubCheck" />
                <label for="pubCheck" style="margin:0;">Published (visible on blog.trucktaxpro.com)</label>
            </div>

            <button type="submit" class="btn-save">Save Post</button>
        </form>
    </div>
</body>
</html>
