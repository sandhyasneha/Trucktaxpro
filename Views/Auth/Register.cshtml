@model Trucktaxpro.Models.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Create Account — TruckTaxPro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@@600;700&family=IBM+Plex+Sans:wght@@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
            .auth-wrap {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--ink);
                padding: 24px;
                position: relative;
            }

            .top-logo {
                position: absolute;
                top: 28px;
                left: 32px;
                width: 220px;
            }

            .auth-card {
                background: var(--white);
                border-radius: 8px;
                padding: 40px;
                width: 100%;
                max-width: 440px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.3);
                border-top: 4px solid var(--amber);
                position: relative;
            }

            .close-btn {
                position: absolute;
                top: 14px;
                right: 16px;
                color: var(--steel);
                font-size: 24px;
                font-weight: 700;
                line-height: 1;
                cursor: pointer;
                text-decoration: none;
                z-index: 2;
            }

                .close-btn:hover {
                    color: #B23A2E;
                }

            .auth-card h1 {
                font-size: 20px;
                text-transform: none;
                letter-spacing: 0;
                font-weight: 600;
                color: var(--ink);
                margin: 0 0 24px;
            }

            .google-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                width: 100%;
                padding: 13px;
                border: 1px solid var(--line);
                border-radius: 4px;
                background: var(--white);
                color: var(--ink);
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                margin-bottom: 20px;
                text-decoration: none;
            }

            .divider {
                display: flex;
                align-items: center;
                gap: 12px;
                color: var(--steel);
                font-size: 12px;
                margin-bottom: 20px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

                .divider::before, .divider::after {
                    content: "";
                    flex: 1;
                    height: 1px;
                    background: var(--line);
                }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .form-group {
                margin-bottom: 16px;
            }

                .form-group label {
                    display: block;
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--ink);
                    margin-bottom: 6px;
                    text-transform: uppercase;
                    letter-spacing: 0.03em;
                }

                .form-group input[type=email], .form-group input[type=password], .form-group input[type=text], .form-group input[type=tel] {
                    width: 100%;
                    padding: 11px 12px;
                    border: 1px solid var(--line);
                    border-radius: 4px;
                    font-size: 14px;
                    font-family: 'IBM Plex Sans',sans-serif;
                    box-sizing: border-box;
                }

            .radio-group {
                display: flex;
                gap: 20px;
                padding: 6px 0;
            }

                .radio-group label {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    font-size: 14px;
                    font-weight: 500;
                    color: var(--ink);
                    text-transform: none;
                    letter-spacing: 0;
                }

                .radio-group input {
                    width: auto;
                    margin: 0;
                }

            .submit-btn {
                width: 100%;
                padding: 13px;
                background: var(--ink);
                color: var(--cream);
                border: none;
                border-radius: 4px;
                font-weight: 600;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                cursor: pointer;
            }

            .validation-summary {
                color: #B23A2E;
                font-size: 13px;
                margin-bottom: 16px;
            }

            .field-validation-error {
                color: #B23A2E;
                font-size: 12px;
                display: block;
                margin-top: 4px;
            }

            .switch-link {
                display: block;
                text-align: center;
                margin-top: 16px;
                font-size: 13px;
                color: var(--steel);
            }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <img src="~/images/logo.svg" alt="TruckTaxPro" class="top-logo" />

        <div class="auth-card">
            <a href="/" class="close-btn" aria-label="Close">&times;</a>
            <h1>Create your TruckTaxPro account</h1>

            <a class="google-btn" href="/api/account/login">Sign up with Google</a>
            <div class="divider">or</div>

            <div asp-validation-summary="All" class="validation-summary"></div>

            <form asp-action="Register" asp-controller="Auth" method="post">
                <div class="form-group">
                    <label asp-for="FullName">Full Name</label>
                    <input asp-for="FullName" type="text" placeholder="Enter your name" />
                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" placeholder="At least 8 characters" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Confirm password</label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Re-enter password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" placeholder="(555) 000-1234" maxlength="14" oninput="formatPhoneNumber(this)" />
                    <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label>I'm a</label>
                    <div class="radio-group">
                        <label><input type="radio" name="IsTaxPreparer" value="false" checked /> Tax Payer</label>
                        <label><input type="radio" name="IsTaxPreparer" value="true" /> Tax Preparer</label>
                    </div>
                    <span asp-validation-for="IsTaxPreparer" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label>Self-Employed</label>
                    <div class="radio-group">
                        <label><input type="radio" name="IsSelfEmployed" value="true" checked /> Yes</label>
                        <label><input type="radio" name="IsSelfEmployed" value="false" /> No</label>
                    </div>
                    <span asp-validation-for="IsSelfEmployed" class="field-validation-error"></span>
                </div>

                <button type="submit" class="submit-btn">Create Account</button>
            </form>

            <a href="/Auth/Login" class="switch-link">Already have an account? Sign in</a>
        </div>
    </div>
    <script>
            function formatPhoneNumber(input) {
                let digits = input.value.replace(/\D/g, '').slice(0, 10);
                let formatted = '';
                if (digits.length > 0) formatted = '(' + digits.slice(0, 3);
                if (digits.length >= 3) formatted += ') ';
                if (digits.length >= 3) formatted += digits.slice(3, 6);
                if (digits.length >= 6) formatted += '-' + digits.slice(6, 10);
                input.value = formatted;
            }
    </script>
</body>
</html>
