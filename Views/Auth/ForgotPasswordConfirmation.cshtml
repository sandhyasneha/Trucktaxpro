@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Check your email — TruckTaxPro</title>
    <link rel="stylesheet" href="~/css/site.css">
    <style>
            .auth-wrap {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--ink);
                padding: 24px;
            }

            .auth-card {
                background: var(--white);
                border-radius: 8px;
                padding: 40px;
                width: 100%;
                max-width: 400px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.3);
                text-align: center;
            }

                .auth-card h1 {
                    font-size: 20px;
                    text-transform: none;
                    letter-spacing: 0;
                    font-weight: 600;
                    color: var(--ink);
                    margin-bottom: 12px;
                }

                .auth-card p {
                    font-size: 14px;
                    color: var(--steel);
                    line-height: 1.5;
                }

            .switch-link {
                display: block;
                margin-top: 20px;
                font-size: 13px;
                color: var(--steel);
            }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card">
            <h1>Check your email</h1>
            <p>If an account exists with that email, we've sent a link to reset your password.</p>
            <a href="/Auth/Login" class="switch-link">Back to sign in</a>
        </div>
    </div>
</body>
</html>